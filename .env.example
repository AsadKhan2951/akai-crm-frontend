# ---------- Supabase (database + auth + storage) ----------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
# Server-only. Used by cron/system jobs. Never expose in the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# ---------- App ----------
# Public HTTPS URL of this app on DigitalOcean (used in unsubscribe and callback links)
NEXT_PUBLIC_APP_URL="https://crm.example.com"

# Protected cron endpoints (/api/cron/*). The Backend repo's GitHub Actions send this as a Bearer token.
CRON_SECRET="replace-with-long-random-cron-secret"
ADMIN_CRON_SECRET=""

# ---------- Email (Resend) ----------
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="AKAI CRM <notifications@example.com>"
RESEND_WEBHOOK_SECRET="replace-with-resend-svix-webhook-secret"

# ---------- WhatsApp (Meta Cloud API) ----------
META_WHATSAPP_ACCESS_TOKEN="replace-with-meta-access-token"
META_WHATSAPP_PHONE_NUMBER_ID="replace-with-meta-phone-number-id"
META_WHATSAPP_VERIFY_TOKEN="replace-with-webhook-verification-token"
META_WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
META_GRAPH_API_VERSION="v23.0"
MESSAGE_UNSUBSCRIBE_SECRET="replace-with-long-random-unsubscribe-secret"

# ---------- AI (Anthropic Claude) - server-only ----------
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_MODEL="replace-with-approved-claude-model"

# ---------- Web Push ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# ---------- Voice transcription (optional) ----------
VOICE_TRANSCRIPTION_API_KEY="replace-with-voice-transcription-api-key"
VOICE_TRANSCRIPTION_URL="https://api.openai.com/v1/audio/transcriptions"
VOICE_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# ---------- Error monitoring (optional) ----------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
